# Application database. Must be PostgreSQL, not MySQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/SHADOW_DATABASE?sslmode=require"

APP_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"
APP_URL="https://your-vercel-domain.vercel.app"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
# Set to "false" to hide Google OAuth while the Clerk Google provider is not configured.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="true"

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4.1-mini"

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_TRIAL_CNY="price_..."
STRIPE_PRICE_TRIAL_USD="price_..."
STRIPE_PRICE_DATABASE_SETUP="price_..."
STRIPE_PRICE_PROFESSIONAL_CNY="price_..."
STRIPE_PRICE_PROFESSIONAL_USD="price_..."

RESEND_API_KEY="re_..."
HELP_REQUEST_FROM_EMAIL="Monarca AI <support@your-domain.com>"
HELP_REQUEST_RECIPIENT_EMAIL="support-recipient@example.com"

R2_ACCOUNT_ID="cloudflare-account-id"
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="monarca-uploads"

SHOPIFY_CLIENT_ID="shopify-client-id"
SHOPIFY_API_KEY="shopify-client-id"
SHOPIFY_CLIENT_SECRET="shopify-client-secret"
SHOPIFY_REDIRECT_URI="https://your-domain.com/api/connectors/shopify/callback"
SHOPIFY_SCOPES="read_orders,read_products,read_customers,read_fulfillments,write_draft_orders,write_orders"
SHOPIFY_API_VERSION="2025-10"
CONNECTOR_TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# Preferred large-file storage.
SUPABASE_URL="https://PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="monarca-uploads"
