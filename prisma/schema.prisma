generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  VIEWER
}

enum DataSourceType {
  SQL_SERVER
  POSTGRESQL
  MYSQL
  SNOWFLAKE
  BIGQUERY
  EXCEL
  CSV
  GOOGLE_ANALYTICS
  STRIPE
  ECOMMERCE_PLATFORM
  ADS_PLATFORM
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  FAILED
  DISCONNECTED
}

enum MetricLayer {
  PRIMARY
  DRIVER
  DIAGNOSTIC
}

enum MetricMaintainerRole {
  AI
  USER
}

enum MetricStatus {
  AI_READY
  NEEDS_MAPPING
  NEEDS_VALIDATION
}

enum MetricExpressionType {
  AGGREGATE
  RATE
  CALCULATION
}

enum RecommendationStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TicketType {
  DATA_CONNECTION
  REPORT_GENERATION
  BILLING
  ACCOUNT_ACCESS
  OTHER
}

enum TicketPriority {
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SubscriptionPlan {
  TRIAL
  PROFESSIONAL
  ENTERPRISE
  DATABASE_SETUP
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  TRIALING
  CANCELED
  PAST_DUE
  UNPAID
  EXPIRED
}

enum PlanType {
  FREE
  ONE_TIME
  MONTHLY
}

enum BillingCycle {
  NONE
  ONE_TIME
  MONTHLY
}

enum BillingProvider {
  STRIPE
  MANUAL
}

enum ReportGenerationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DecisionActionType {
  SCALE
  REDUCE
  OPTIMIZE
  MONITOR
}

enum DecisionActionStatus {
  PENDING_APPROVAL
  RECOMMENDED
  ACCEPTED
  EXECUTING
  COMPLETED
  EVALUATED
  LEARNED
  REJECTED
}

enum PaymentOrderType {
  ONE_TIME
  MONTHLY
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum WorkspaceMemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

model User {
  id                  String             @id @default(cuid())
  clerkUserId         String             @unique
  email               String             @unique
  name                String
  avatarUrl           String?            @map("avatar_url")
  locale              String             @default("en")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  memberships         WorkspaceMember[]
  ownedWorkspaces     Workspace[]        @relation("WorkspaceOwner")
  maintainedMetrics   MetricDefinition[] @relation("MetricMaintainer")
  assignedTickets     SupportTicket[]    @relation("TicketAssignee")
  submittedTickets    SupportTicket[]    @relation("TicketSubmitter")
  paymentOrders       PaymentOrder[]
  generatedReportRuns ReportRun[]        @relation("ReportRunGenerator")
  oauthStates         OAuthState[]
}

model Workspace {
  id                          String                       @id @default(cuid())
  slug                        String                       @unique
  name                        String
  ownerId                     String
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  owner                       User                         @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                     WorkspaceMember[]
  dataSources                 DataSourceConnection[]
  schemaSnapshots             SchemaSnapshot[]
  metrics                     MetricDefinition[]
  briefings                   DailyBriefing[]
  supportTickets              SupportTicket[]
  subscriptions               WorkspaceSubscription[]
  usageAllowances             WorkspaceUsageAllowance[]
  reportGenerationJobs        ReportGenerationJob[]
  reportEntitlement           ReportEntitlement?
  reportGenerationLogs        ReportGenerationLog[]
  reportMetricCaches          ReportMetricCache[]
  metricSnapshots             MetricSnapshot[]
  reportSnapshots             ReportSnapshot[]
  reportHistory               ReportHistory[]
  reportRuns                  ReportRun[]
  inviteLinks                 WorkspaceInviteLink[]
  oauthStates                 OAuthState[]
  ecommerceConnectorAccounts  EcommerceConnectorAccount[]
  ecommerceSyncRuns           EcommerceSyncRun[]
  ecommerceSyncArtifacts      EcommerceSyncArtifact[]
  semanticMappingMemories     SemanticMappingMemory[]
  decisionActions             DecisionAction[]
  optimizationDecisions       OptimizationDecision[]
  optimizationLearningRecords OptimizationLearningRecord[]
  decisionTrackingSnapshots   DecisionTrackingSnapshot[]
  decisionSnapshots           DecisionSnapshot[]
  decisionGenerationLogs      DecisionGenerationLog[]
  asyncJobs                   AsyncJob[]
  snapshots                   Snapshot[]
  backgroundJobs              BackgroundJob[]
  unifiedIngestionJobs        UnifiedIngestionJob[]
}

model SemanticMappingMemory {
  id                        String    @id @default(cuid())
  workspaceId               String
  fieldName                 String
  normalizedFieldName       String
  platform                  String    @default("*")
  mappedConcept             String
  embeddingVector           Json
  confidenceScore           Float     @default(0)
  usageCount                Int       @default(0)
  userFeedbackScore         Float     @default(0)
  embeddingSimilarityWeight Float     @default(0.32)
  metadataJson              Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  lastSeenAt                DateTime  @default(now())
  workspace                 Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, normalizedFieldName, mappedConcept])
  @@index([workspaceId, platform])
  @@index([workspaceId, normalizedFieldName])
  @@index([workspaceId, mappedConcept])
  @@index([lastSeenAt])
}

model WorkspaceMember {
  id                String                @id @default(cuid())
  workspaceId       String
  userId            String?
  invitedEmail      String?
  role              WorkspaceRole         @default(VIEWER)
  status            WorkspaceMemberStatus @default(ACTIVE)
  invitedBy         String?
  clerkInvitationId String?               @map("clerk_invitation_id")
  joinedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@unique([workspaceId, userId])
  @@unique([workspaceId, invitedEmail])
}

model WorkspaceInviteLink {
  id          String        @id @default(cuid())
  workspaceId String
  tokenHash   String        @unique
  role        WorkspaceRole @default(VIEWER)
  createdBy   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
}

model DataSourceConnection {
  id                         String                      @id @default(cuid())
  workspaceId                String
  type                       DataSourceType
  name                       String
  provider                   String
  isActive                   Boolean                     @default(true)
  status                     ConnectionStatus            @default(PENDING)
  connectionMode             String?
  authMethod                 String?
  config                     Json?
  schemas                    Json?
  lastErrorMessage           String?
  connectedAt                DateTime?
  lastSyncAt                 DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  workspace                  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  schemaSnapshots            SchemaSnapshot[]
  stats                      DataSourceStats[]
  primaryReportRuns          ReportRun[]                 @relation("ReportRunPrimaryDataSource")
  ecommerceConnectorAccounts EcommerceConnectorAccount[]
  ecommerceSyncRuns          EcommerceSyncRun[]
  ecommerceSyncArtifacts     EcommerceSyncArtifact[]

  @@index([workspaceId, status])
}

model OAuthState {
  id           String    @id @default(cuid())
  stateHash    String    @unique
  provider     String
  workspaceId  String
  userId       String?
  shopDomain   String
  redirectUri  String
  scopes       String
  nonce        String
  expiresAt    DateTime
  usedAt       DateTime?
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, provider])
  @@index([provider, shopDomain])
  @@index([expiresAt])
}

model EcommerceConnectorAccount {
  id                   String                  @id @default(cuid())
  workspaceId          String
  dataSourceId         String?
  provider             String
  shopDomain           String
  encryptedAccessToken String
  scopes               String
  grantedScopes        String?
  requiredScopes       String?
  scopeStatus          String                  @default("OK")
  status               String                  @default("connected")
  lastSyncedAt         DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource           DataSourceConnection?   @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  syncRuns             EcommerceSyncRun[]
  syncArtifacts        EcommerceSyncArtifact[]

  @@unique([workspaceId, provider, shopDomain])
  @@index([workspaceId, dataSourceId])
  @@index([workspaceId, provider])
}

model EcommerceSyncRun {
  id                 String                    @id @default(cuid())
  workspaceId        String
  dataSourceId       String
  connectorAccountId String
  provider           String
  shopDomain         String
  syncRunId          String                    @unique
  idempotencyKey     String
  status             String                    @default("running")
  syncWindowStart    DateTime?
  syncWindowEnd      DateTime?
  cursorJson         Json?
  rowsPulled         Int                       @default(0)
  rowsNormalized     Int                       @default(0)
  rowsRejected       Int                       @default(0)
  manifestKey        String?
  errorMessage       String?
  startedAt          DateTime                  @default(now())
  finishedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource         DataSourceConnection      @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  connectorAccount   EcommerceConnectorAccount @relation(fields: [connectorAccountId], references: [id], onDelete: Cascade)
  artifacts          EcommerceSyncArtifact[]

  @@unique([workspaceId, dataSourceId, provider, shopDomain, idempotencyKey])
  @@index([workspaceId, dataSourceId, provider])
  @@index([connectorAccountId, startedAt])
}

model EcommerceSyncArtifact {
  id                 String                    @id @default(cuid())
  workspaceId        String
  dataSourceId       String
  connectorAccountId String
  syncRunId          String
  provider           String
  shopDomain         String
  artifactType       String
  tableName          String?
  artifactKey        String
  checksum           String
  rowCount           Int                       @default(0)
  createdAt          DateTime                  @default(now())
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource         DataSourceConnection      @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  connectorAccount   EcommerceConnectorAccount @relation(fields: [connectorAccountId], references: [id], onDelete: Cascade)
  syncRun            EcommerceSyncRun          @relation(fields: [syncRunId], references: [syncRunId], onDelete: Cascade)

  @@unique([syncRunId, artifactKey])
  @@index([workspaceId, dataSourceId, provider])
  @@index([syncRunId])
}

model DataSourceStats {
  id                     String               @id @default(cuid())
  dataSourceConnectionId String
  tableName              String
  rowCount               Int?
  minDate                DateTime?
  maxDate                DateTime?
  dateField              String?
  schemaHash             String?
  calculatedAt           DateTime             @default(now())
  dataSource             DataSourceConnection @relation(fields: [dataSourceConnectionId], references: [id], onDelete: Cascade)

  @@unique([dataSourceConnectionId, tableName])
  @@index([dataSourceConnectionId])
}

model SchemaSnapshot {
  id               String                @id @default(cuid())
  workspaceId      String
  dataSourceId     String?
  version          Int
  status           ConnectionStatus      @default(PENDING)
  schemaStatus     String                @default("PENDING")
  canonicalStatus  String                @default("NOT_STARTED")
  canonicalVersion String?
  schemaJson       Json
  qualityReport    Json?
  createdAt        DateTime              @default(now())
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource       DataSourceConnection? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  reportRuns       ReportRun[]

  @@unique([workspaceId, version])
}

model MetricDefinition {
  id               String               @id @default(cuid())
  workspaceId      String
  layer            MetricLayer
  category         String
  name             String
  definition       String
  formula          String
  expressionType   MetricExpressionType @default(CALCULATION)
  unit             String?
  window           String?
  sourceMetricIds  Json?
  mappingJson      Json?
  lineageJson      Json?
  isActive         Boolean              @default(true)
  maintainerRole   MetricMaintainerRole
  maintainerUserId String?
  status           MetricStatus         @default(NEEDS_MAPPING)
  tagsJson         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  maintainedByUser User?                @relation("MetricMaintainer", fields: [maintainerUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([workspaceId, layer])
}

model DailyBriefing {
  id           String    @id @default(cuid())
  workspaceId  String
  briefingDate DateTime
  title        String
  summary      String
  confidence   Int?
  payloadJson  Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  insights     Insight[]

  @@unique([workspaceId, briefingDate])
  @@index([workspaceId, briefingDate])
}

model Insight {
  id                    String                 @id @default(cuid())
  briefingId            String
  title                 String
  description           String
  anomalyType           String?
  anomalyTypeNormalized String?
  impactScore           Float?
  confidence            Int?
  dataQualityScore      Int?
  sampleSize            Int?
  relatedMetricIds      Json?
  explanationJson       Json?
  evidenceJson          Json?
  createdAt             DateTime               @default(now())
  briefing              DailyBriefing          @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  recommendations       ActionRecommendation[]
}

model ActionRecommendation {
  id                String               @id @default(cuid())
  insightId         String
  title             String
  ownerTeam         String?
  targetOwner       String?
  executionPriority String?
  impactScore       Float?
  estimatedOutcome  String?
  workflowAction    String?
  status            RecommendationStatus @default(PLANNED)
  dueDate           DateTime?
  actualOutcome     String?
  createdAt         DateTime             @default(now())
  insight           Insight              @relation(fields: [insightId], references: [id], onDelete: Cascade)
}

model DecisionAction {
  id                   String                     @id @default(cuid())
  workspaceId          String
  skuId                String
  recommendedAction    String?
  optimizationGoal     String?
  lifecycleStage       String?
  actionType           DecisionActionType
  decisionDrivers      Json
  expectedImpact       Float                      @default(0)
  actualImpact         Float?
  confidence           Float                      @default(0)
  status               DecisionActionStatus       @default(PENDING_APPROVAL)
  baselineSnapshotId   String?
  predictionSnapshotId String?
  actionPayload        Json?
  createdAt            DateTime                   @default(now())
  acceptedAt           DateTime?
  executionStartedAt   DateTime?
  executionCompletedAt DateTime?
  executedAt           DateTime?
  completedAt          DateTime?
  evaluatedAt          DateTime?
  updatedAt            DateTime                   @updatedAt
  workspace            Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  outcome              DecisionOutcome?
  trackingSnapshots    DecisionTrackingSnapshot[]
  baselineSnapshot     DecisionSnapshot?          @relation("DecisionBaselineSnapshot", fields: [baselineSnapshotId], references: [id])
  predictionSnapshot   DecisionSnapshot?          @relation("DecisionPredictionSnapshot", fields: [predictionSnapshotId], references: [id])

  @@index([workspaceId, status])
  @@index([workspaceId, skuId])
  @@index([baselineSnapshotId])
  @@index([predictionSnapshotId])
  @@index([createdAt])
}

model DecisionSnapshot {
  id                        String           @id @default(cuid())
  workspaceId               String
  skuId                     String           @default("workspace")
  snapshotType              String
  acceptedAction            String           @default("snapshot")
  optimizationType          String?
  algorithmVersion          String?
  optimizationVersion       String?
  canonicalSnapshotVersion  String?
  metricSnapshotVersion     String?
  simulationVersion         String?
  inputHash                 String?
  generatedAt               DateTime?
  lifecycle                 String?
  optimizationGoal          String?
  assumptions               Json?
  recommendationsJson       Json?
  expectedProfitImpact      Float?
  baselineMetrics           Json             @default("{}")
  predictedMetrics          Json             @default("{}")
  alternatives              Json             @default("[]")
  reasoning                 Json?
  confidence                Float            @default(0)
  createdAt                 DateTime         @default(now())
  workspace                 Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  baselineDecisionActions   DecisionAction[] @relation("DecisionBaselineSnapshot")
  predictionDecisionActions DecisionAction[] @relation("DecisionPredictionSnapshot")

  @@index([workspaceId, skuId])
  @@index([workspaceId, snapshotType])
  @@index([workspaceId, optimizationType, createdAt])
  @@index([workspaceId, optimizationType, inputHash])
  @@index([workspaceId, algorithmVersion])
  @@index([createdAt])
}

model DecisionGenerationLog {
  id                       String    @id @default(cuid())
  workspaceId              String
  sourceJobId              String?
  decisionSnapshotId       String?
  optimizationType         String
  algorithmVersion         String
  optimizationVersion      String
  canonicalSnapshotVersion String?
  metricSnapshotVersion    String?
  simulationVersion        String?
  inputHash                String?
  simulationCount          Int       @default(0)
  executionTimeMs          Int       @default(0)
  resultSummary            Json?
  errorMessage             String?
  createdAt                DateTime  @default(now())
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, optimizationType, createdAt])
  @@index([workspaceId, inputHash])
  @@index([decisionSnapshotId])
  @@index([sourceJobId])
}

model DecisionOutcome {
  id                     String         @id @default(cuid())
  decisionId             String         @unique
  baselineProfit         Float          @default(0)
  expectedProfitChange   Float          @default(0)
  actualProfitChange     Float          @default(0)
  attributedProfitChange Float          @default(0)
  organicProfitChange    Float          @default(0)
  profitVariance         Float          @default(0)
  outcomeStatus          String         @default("NEUTRAL")
  predictedProfit        Float          @default(0)
  realizedProfit         Float          @default(0)
  profitDelta            Float          @default(0)
  accuracy               Float?
  attributionJson        Json?
  learningSignals        Json
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  decision               DecisionAction @relation(fields: [decisionId], references: [id], onDelete: Cascade)
}

model DecisionTrackingSnapshot {
  id                String         @id @default(cuid())
  workspaceId       String
  decisionId        String
  snapshotDate      DateTime
  dayIndex          Int
  baselineMetrics   Json
  expectedMetrics   Json
  actualMetrics     Json
  attributedMetrics Json?
  organicMetrics    Json?
  createdAt         DateTime       @default(now())
  decision          DecisionAction @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([decisionId, snapshotDate])
  @@index([workspaceId, snapshotDate])
  @@index([workspaceId, decisionId])
}

model OptimizationDecision {
  id                     String    @id @default(cuid())
  workspaceId            String
  userId                 String?
  skuId                  String
  decisionDate           DateTime  @default(now())
  recommendedAction      String
  optimizationGoal       String
  lifecycleStage         String?
  expectedProfitImpact   Float     @default(0)
  expectedRevenueImpact  Float     @default(0)
  expectedCostChange     Float     @default(0)
  expectedAdSpend        Float     @default(0)
  confidence             Float     @default(0)
  riskScore              Float     @default(0)
  alternativeActions     Json
  decisionStatus         String    @default("PENDING")
  acceptedBy             String?
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  executionStatus        String    @default("NOT_STARTED")
  executionStartDate     DateTime?
  executionEndDate       DateTime?
  actualRevenueChange    Float?
  actualProfitChange     Float?
  actualCostChange       Float?
  actualAdSpendChange    Float?
  attributedProfitChange Float?
  organicProfitChange    Float?
  outcomeStatus          String?
  attributionJson        Json?
  predictionError        Float?
  learningStatus         String    @default("PENDING_OUTCOME")
  trackingActionId       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, decisionStatus])
  @@index([workspaceId, skuId])
  @@index([workspaceId, recommendedAction])
  @@index([trackingActionId])
}

model OptimizationLearningRecord {
  id           String    @id @default(cuid())
  workspaceId  String
  skuCategory  String?
  industry     String?
  lifecycle    String?
  action       String
  prediction   Float     @default(0)
  actual       Float     @default(0)
  error        Float     @default(0)
  success      Boolean   @default(false)
  confidence   Float?
  metadataJson Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, action])
  @@index([workspaceId, lifecycle])
  @@index([createdAt])
}

model WorkspaceSubscription {
  id                      String             @id @default(cuid())
  workspaceId             String
  planType                PlanType           @default(FREE)
  status                  SubscriptionStatus @default(FREE)
  billingCycle            BillingCycle       @default(NONE)
  provider                BillingProvider    @default(MANUAL)
  providerCustomerId      String?
  providerSubscriptionId  String?            @unique
  providerPaymentIntentId String?
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  canceledAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  workspace               Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, planType])
  @@index([providerPaymentIntentId])
}

model WorkspaceUsageAllowance {
  id                       String    @id @default(cuid())
  workspaceId              String
  reportGenerationsAllowed Int       @default(0)
  reportGenerationsUsed    Int       @default(0)
  source                   String
  referenceId              String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, referenceId])
  @@index([workspaceId, createdAt])
}

model ReportGenerationJob {
  id           String                    @id @default(cuid())
  workspaceId  String
  reportId     String?
  status       ReportGenerationJobStatus @default(PENDING)
  errorMessage String?
  metadata     Json?
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([reportId])
}

model ReportEntitlement {
  id                       String    @id @default(cuid())
  workspaceId              String    @unique
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  firstFreeReportUsed      Boolean   @default(false)
  firstFreeReportUsedAt    DateTime?
  oneTimeReportAvailable   Boolean   @default(false)
  oneTimeReportPurchasedAt DateTime?
  oneTimeReportUsedAt      DateTime?
  subscriptionStatus       String    @default("free")
  subscriptionPlan         String?   @default("free")
  monthlyUnlimited         Boolean   @default(false)
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model ReportGenerationLog {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reportId       String?
  reportType     String
  accessType     String
  status         String
  idempotencyKey String?   @unique
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([workspaceId, status, createdAt])
  @@index([reportId])
}

model ReportMetricCache {
  id                    String    @id @default(cuid())
  workspaceId           String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSourceIds         Json?
  metricIds             Json?
  dateField             String?
  dateRangePreset       String
  startDate             DateTime?
  endDate               DateTime?
  filtersHash           String    @default("none")
  cacheKey              String    @unique
  payloadJson           Json
  sourceSnapshotVersion Int?
  refreshStatus         String    @default("fresh")
  generatedAt           DateTime  @default(now())
  staleAt               DateTime?
  lastAccessedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([workspaceId, dateRangePreset, startDate, endDate])
  @@index([workspaceId, refreshStatus, staleAt])
}

model ReportRun {
  id                      String                @id @default(cuid())
  workspaceId             String
  generatedByUserId       String?
  primaryDataSourceId     String?
  dataSourceIds           Json
  reportMode              String
  dateRangeStart          DateTime?
  dateRangeEnd            DateTime?
  sourceSnapshotVersion   Int?
  schemaSnapshotId        String?
  semanticSnapshotVersion String?
  semanticSchemaHash      String?
  domain                  String?
  cacheKey                String
  status                  String                @default("completed")
  payloadJson             Json
  composedReportJson      Json?
  briefingPayloadJson     Json?
  reportHistoryId         String?
  dailyBriefingId         String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  workspace               Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedByUser         User?                 @relation("ReportRunGenerator", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  primaryDataSource       DataSourceConnection? @relation("ReportRunPrimaryDataSource", fields: [primaryDataSourceId], references: [id], onDelete: SetNull)
  schemaSnapshot          SchemaSnapshot?       @relation(fields: [schemaSnapshotId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, cacheKey])
  @@index([workspaceId, primaryDataSourceId])
  @@index([workspaceId, reportMode])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, sourceSnapshotVersion])
}

model MetricSnapshot {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metricId        String?
  metricName      String
  displayName     String?
  value           Float?
  valueJson       Json?
  dimensions      Json?
  period          String?
  dataSourceId    String?
  schemaVersion   Int?
  cacheKey        String?
  unit            String?
  scope           String?
  grain           String?
  businessModule  String?
  sourceDataset   String?
  dateField       String?
  snapshotDate    DateTime
  dateRangePreset String?
  startDate       DateTime?
  endDate         DateTime?
  calculatedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@unique([workspaceId, cacheKey])
  @@index([workspaceId, metricName, snapshotDate])
  @@index([workspaceId, snapshotDate])
  @@index([workspaceId, dateRangePreset, startDate, endDate])
  @@index([workspaceId, dataSourceId, schemaVersion, period])
}

model ReportSnapshot {
  id                    String    @id @default(cuid())
  workspaceId           String
  reportType            String
  periodStart           DateTime?
  periodEnd             DateTime?
  contentJson           Json
  sourceSnapshotId      String?
  sourceSnapshotVersion Int?
  cacheKey              String?
  warning               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, reportType, cacheKey])
  @@index([workspaceId, reportType, createdAt])
  @@index([workspaceId, periodStart, periodEnd])
  @@index([sourceSnapshotId])
}

model AsyncJob {
  id              String     @id @default(cuid())
  workspaceId     String
  type            String
  status          String     @default("QUEUED")
  progress        Int        @default(0)
  currentStep     String?
  payload         Json?
  resultReference Json?
  errorMessage    String?
  retryCount      Int        @default(0)
  maxRetries      Int        @default(3)
  heartbeatAt     DateTime?
  lockedAt        DateTime?
  lockedBy        String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots       Snapshot[]

  @@index([workspaceId, type, status])
  @@index([workspaceId, createdAt])
  @@index([status, heartbeatAt])
  @@index([status, updatedAt])
}

model Snapshot {
  id            String    @id @default(cuid())
  workspaceId   String
  sourceJobId   String?
  type          String
  version       String
  status        String    @default("READY")
  dataReference Json?
  metadataJson  Json?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceJob     AsyncJob? @relation(fields: [sourceJobId], references: [id], onDelete: SetNull)

  @@index([workspaceId, type, createdAt])
  @@index([sourceJobId])
  @@index([workspaceId, status])
}

model BackgroundJob {
  id           String    @id @default(cuid())
  workspaceId  String
  type         String
  status       String    @default("PENDING")
  startedAt    DateTime?
  completedAt  DateTime?
  error        String?
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, type, status])
  @@index([workspaceId, createdAt])
}

model UnifiedIngestionJob {
  id           String    @id @default(cuid())
  workspaceId  String
  dataSourceId String
  fileId       String?
  status       String    @default("QUEUED")
  progress     Int       @default(0)
  currentStep  String?
  errorMessage String?
  heartbeatAt  DateTime?
  lockedAt     DateTime?
  lockedBy     String?
  retryCount   Int       @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  metadataJson Json?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([status, heartbeatAt])
  @@index([workspaceId, createdAt])
  @@index([dataSourceId])
}

model ReportHistory {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reportMode        String
  reportTimeMode    String
  title             String
  summaryJson       Json?
  contentJson       Json?
  selectedDateRange Json?
  status            String    @default("completed")
  generatedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([workspaceId, reportMode, generatedAt])
  @@index([workspaceId, generatedAt])
}

model Plan {
  id                      String         @id @default(cuid())
  code                    String         @unique
  name                    String
  type                    PlanType
  price                   Decimal        @db.Decimal(10, 2)
  currency                String         @default("USD")
  description             String
  reportQuota             Int            @default(0)
  aiTokenQuota            Int            @default(0)
  databaseConnectionQuota Int            @default(0)
  includesHumanService    Boolean        @default(false)
  validDays               Int?
  isActive                Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  orders                  PaymentOrder[]

  @@index([type, isActive])
}

model PaymentOrder {
  id                String             @id @default(cuid())
  userId            String
  workspaceId       String?
  planId            String
  orderType         PaymentOrderType
  amount            Decimal            @db.Decimal(10, 2)
  currency          String             @default("USD")
  status            PaymentOrderStatus @default(PENDING)
  paymentProvider   String?
  providerPaymentId String?            @unique
  providerSessionId String?            @unique
  createdAt         DateTime           @default(now())
  paidAt            DateTime?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([workspaceId, status])
  @@index([planId, orderType])
}

model SupportTicket {
  id          String         @id @default(cuid())
  workspaceId String?
  submitterId String?
  assigneeId  String?
  type        TicketType
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)
  subject     String
  description String
  contextJson Json?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  submitter   User?          @relation("TicketSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([submitterId, createdAt])
  @@index([assigneeId, status])
}

model ConsultingRequest {
  id                    String   @id @default(cuid())
  name                  String
  email                 String
  companyName           String?
  role                  String?
  dataSources           String?
  painPoints            String?
  preferredMeetingTimes String?
  message               String?
  status                String   @default("NEW")
  source                String?  @default("consulting_page")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([email])
}
