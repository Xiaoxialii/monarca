  @@index([workspaceId, reportMode, generatedAt])
  @@index([workspaceId, generatedAt])
}

model Plan {
  id                      String         @id @default(cuid())
  code                    String         @unique
  name                    String
  type                    PlanType
  price                   Decimal        @db.Decimal(10, 2)
  currency                String         @default("USD")
  description             String
  reportQuota             Int            @default(0)
  aiTokenQuota            Int            @default(0)
  databaseConnectionQuota Int            @default(0)
  includesHumanService    Boolean        @default(false)
  validDays               Int?
  isActive                Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  orders                  PaymentOrder[]

  @@index([type, isActive])
}

model PaymentOrder {
  id                String             @id @default(cuid())
  userId            String
  workspaceId       String?
  planId            String
  orderType         PaymentOrderType
  amount            Decimal            @db.Decimal(10, 2)
  currency          String             @default("USD")
  status            PaymentOrderStatus @default(PENDING)
  paymentProvider   String?
  providerPaymentId String?            @unique
  providerSessionId String?            @unique
  createdAt         DateTime           @default(now())
  paidAt            DateTime?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([workspaceId, status])
  @@index([planId, orderType])
}

model SupportTicket {
  id          String         @id @default(cuid())
  workspaceId String?
  submitterId String?
  assigneeId  String?
  type        TicketType
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)
  subject     String
  description String
  contextJson Json?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  submitter   User?          @relation("TicketSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([submitterId, createdAt])
  @@index([assigneeId, status])
}

