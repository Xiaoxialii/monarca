  optimizationLevel            String?
  confidenceScore              Float?
  missingDataRequirements      Json      @default("[]")
  reportShellJson              Json      @default("{}")
  portfolioOptimizationJson    Json      @default("{}")
  queueRowsJson                Json      @default("[]")
  portfolioRowsJson            Json      @default("[]")
  portfolioSummaryJson         Json?
