generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  VIEWER
}

enum SystemRole {
  USER
  SUPER_ADMIN
}

enum DataSourceType {
  SQL_SERVER
  POSTGRESQL
  MYSQL
  SNOWFLAKE
  BIGQUERY
  EXCEL
  CSV
  GOOGLE_ANALYTICS
  STRIPE
  ECOMMERCE_PLATFORM
  ADS_PLATFORM
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  FAILED
  DISCONNECTED
}

enum MetricLayer {
  PRIMARY
  DRIVER
  DIAGNOSTIC
}

enum MetricMaintainerRole {
  AI
  USER
}

enum MetricStatus {
  AI_READY
  NEEDS_MAPPING
  NEEDS_VALIDATION
}

enum MetricExpressionType {
  AGGREGATE
  RATE
  CALCULATION
}

enum RecommendationStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TicketType {
  DATA_CONNECTION
  REPORT_GENERATION
  BILLING
  ACCOUNT_ACCESS
  OTHER
}

enum TicketPriority {
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SubscriptionPlan {
  TRIAL
  PROFESSIONAL
  ENTERPRISE
  DATABASE_SETUP
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  TRIALING
  CANCELED
  PAST_DUE
  UNPAID
  EXPIRED
}

enum PlanType {
  FREE
  ONE_TIME
  MONTHLY
}

enum BillingCycle {
  NONE
  ONE_TIME
  MONTHLY
}

enum BillingProvider {
  STRIPE
  MANUAL
}

enum ReportGenerationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DecisionActionType {
  SCALE
  REDUCE
  OPTIMIZE
  MONITOR
}

enum DecisionActionStatus {
  PENDING_APPROVAL
  RECOMMENDED
  ACCEPTED
  EXECUTING
  COMPLETED
  EVALUATED
  LEARNED
  REJECTED
}

enum OptimizationRecommendationType {
  AD_OPTIMIZATION
  SKU_OPTIMIZATION
  INVENTORY_OPTIMIZATION
}

enum DecisionExecutionMetricType {
  AD
  SKU
  INVENTORY
}

enum DecisionOutcomeStatus {
  PENDING
  CALCULATED
  CONFIRMED
  INSUFFICIENT_DATA
}

enum PaymentOrderType {
  ONE_TIME
  MONTHLY
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum WorkspaceMemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum StorePartnershipApplicationStatus {
  NEW
  UNDER_REVIEW
  QUALIFIED
  CONTACTED
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum StorePartnershipBusinessStage {
  OVERSEAS_STORE
  DOMESTIC_READY_OVERSEAS
  FACTORY_OR_SUPPLIER
  OVERSEAS_EXPANDING_CHANNELS
  OTHER
}

enum StorePartnershipFulfillmentCapability {
  OVERSEAS_WAREHOUSE
  DOMESTIC_DIRECT_SHIPPING
  THIRD_PARTY_CROSS_BORDER_LOGISTICS
  NEED_MONARCA_SUPPORT
  UNSURE_DISCUSS
}

enum CreativeAttributionLevel {
  AD
  CREATIVE
  ASSET
  ASSET_GROUP
  NOT_SEPARATELY_ATTRIBUTABLE
}

enum CreativeAssetType {
  IMAGE
  VIDEO
  PRIMARY_TEXT
  HEADLINE
  DESCRIPTION
  CTA
  CAROUSEL_CARD
  OTHER
}

enum CreativeAssetStatus {
  ACTIVE
  ARCHIVED
  NOT_SEPARATELY_ATTRIBUTABLE
}

enum AdvertisingMappingStatus {
  AUTO_CONFIRMED
  NEEDS_REVIEW
  MANUALLY_CONFIRMED
  REJECTED
  UNMAPPED
  AMBIGUOUS
}

enum AdvertisingMappingMethod {
  CATALOG_PRODUCT_ID
  SHOPIFY_PRODUCT_ID
  SHOPIFY_VARIANT_ID
  GOOGLE_MERCHANT_ITEM_ID
  LANDING_PAGE_URL
  URL_PRODUCT_HANDLE
  UTM_SKU
  URL_SKU_PARAMETER
  AD_NAME_SKU
  CREATIVE_NAME_SKU
  DESTINATION_URL
  MANUAL
  MULTI_PRODUCT_AD
  UNKNOWN
}

enum CreativeAnalysisReadiness {
  READY_FOR_CREATIVE_ANALYSIS
  INSUFFICIENT_DATA
  UNMAPPED_SKU
  LOW_ATTRIBUTION_CONFIDENCE
  MULTI_ASSET_NOT_ATTRIBUTABLE
  MISSING_COST_DATA
  INVENTORY_CONSTRAINED
  LEARNING
}

enum CompetitiveBrandStatus {
  USER_CONFIRMED
  NEEDS_REVIEW
  REJECTED
}

enum PublicAdProvider {
  META_AD_LIBRARY
}

enum PublicAdSyncStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  UNSUPPORTED
}

model User {
  id                  String             @id @default(cuid())
  clerkUserId         String             @unique
  email               String             @unique
  name                String
  avatarUrl           String?            @map("avatar_url")
  locale              String             @default("en")
  systemRole          SystemRole         @default(USER)
  productAccessEnabled Boolean           @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  memberships         WorkspaceMember[]
  ownedWorkspaces     Workspace[]        @relation("WorkspaceOwner")
  maintainedMetrics   MetricDefinition[] @relation("MetricMaintainer")
  assignedTickets     SupportTicket[]    @relation("TicketAssignee")
  submittedTickets    SupportTicket[]    @relation("TicketSubmitter")
  paymentOrders       PaymentOrder[]
  generatedReportRuns ReportRun[]        @relation("ReportRunGenerator")
  oauthStates         OAuthState[]
  productAccessAuditEventsAuthored UserProductAccessAudit[] @relation("ProductAccessAuditActor")
  productAccessAuditEventsReceived UserProductAccessAudit[] @relation("ProductAccessAuditTarget")
}

model UserProductAccessAudit {
  id            String   @id @default(cuid())
  actorUserId   String?
  targetUserId  String
  previousValue Boolean
  newValue      Boolean
  eventType     String
  createdAt     DateTime @default(now())

  actorUser      User? @relation("ProductAccessAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser     User  @relation("ProductAccessAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetUserId, createdAt])
  @@index([eventType, createdAt])
}

model Workspace {
  id                          String                       @id @default(cuid())
  slug                        String                       @unique
  name                        String
  ownerId                     String
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  owner                       User                         @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                     WorkspaceMember[]
  dataSources                 DataSourceConnection[]
  schemaSnapshots             SchemaSnapshot[]
  metrics                     MetricDefinition[]
  briefings                   DailyBriefing[]
  supportTickets              SupportTicket[]
  subscriptions               WorkspaceSubscription[]
  usageAllowances             WorkspaceUsageAllowance[]
  reportGenerationJobs        ReportGenerationJob[]
  reportEntitlement           ReportEntitlement?
  reportGenerationLogs        ReportGenerationLog[]
  reportMetricCaches          ReportMetricCache[]
  metricSnapshots             MetricSnapshot[]
  reportSnapshots             ReportSnapshot[]
  optimizationReportCaches    OptimizationReportCache[]
  reportHistory               ReportHistory[]
  reportRuns                  ReportRun[]
  inviteLinks                 WorkspaceInviteLink[]
  oauthStates                 OAuthState[]
  ecommerceConnectorAccounts  EcommerceConnectorAccount[]
  googleAdsConnections        GoogleAdsConnection[]
  ecommerceSyncRuns           EcommerceSyncRun[]
  ecommerceSyncArtifacts      EcommerceSyncArtifact[]
  semanticMappingMemories     SemanticMappingMemory[]
  decisionActions             DecisionAction[]
  optimizationDecisions       OptimizationDecision[]
  optimizationLearningRecords OptimizationLearningRecord[]
  decisionBaselineSnapshots   DecisionBaselineSnapshot[]
  decisionExecutionMetrics    DecisionExecutionMetric[]
  decisionLearnings           DecisionLearning[]
  decisionTrackingSnapshots   DecisionTrackingSnapshot[]
  decisionSnapshots           DecisionSnapshot[]
  decisionGenerationLogs      DecisionGenerationLog[]
  asyncJobs                   AsyncJob[]
  snapshots                   Snapshot[]
  backgroundJobs              BackgroundJob[]
  unifiedIngestionJobs        UnifiedIngestionJob[]
  advertisingAccounts         AdvertisingAccount[]
  advertisingCampaigns        AdvertisingCampaign[]
  advertisingAdSets           AdvertisingAdSet[]
  advertisingAds              AdvertisingAd[]
  advertisingCreatives        AdvertisingCreative[]
  advertisingCreativeAssets   AdvertisingCreativeAsset[]
  advertisingCreativeAssetLinks AdvertisingCreativeAssetLink[]
  advertisingPerformanceDaily AdvertisingPerformanceDaily[]
  advertisingProductMappings  AdvertisingProductMapping[]
  advertisingProductMappingAudits AdvertisingProductMappingAudit[]
  advertisingProfitSnapshots  AdvertisingProfitSnapshot[]
  competitiveSkuBrands        CompetitiveSkuBrand[]
  competitivePublicAds        CompetitivePublicAd[]
  competitivePublicAdSyncRuns CompetitivePublicAdSyncRun[]
}

model SemanticMappingMemory {
  id                        String    @id @default(cuid())
  workspaceId               String
  fieldName                 String
  normalizedFieldName       String
  platform                  String    @default("*")
  mappedConcept             String
  embeddingVector           Json
  confidenceScore           Float     @default(0)
  usageCount                Int       @default(0)
  userFeedbackScore         Float     @default(0)
  embeddingSimilarityWeight Float     @default(0.32)
  metadataJson              Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  lastSeenAt                DateTime  @default(now())
  workspace                 Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, normalizedFieldName, mappedConcept])
  @@index([workspaceId, platform])
  @@index([workspaceId, normalizedFieldName])
  @@index([workspaceId, mappedConcept])
  @@index([lastSeenAt])
}

model WorkspaceMember {
  id                String                @id @default(cuid())
  workspaceId       String
  userId            String?
  invitedEmail      String?
  role              WorkspaceRole         @default(VIEWER)
  status            WorkspaceMemberStatus @default(ACTIVE)
  invitedBy         String?
  clerkInvitationId String?               @map("clerk_invitation_id")
  joinedAt          DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId])
  @@unique([workspaceId, userId])
  @@unique([workspaceId, invitedEmail])
}

model WorkspaceInviteLink {
  id          String        @id @default(cuid())
  workspaceId String
  tokenHash   String        @unique
  role        WorkspaceRole @default(VIEWER)
  createdBy   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
}

model DataSourceConnection {
  id                         String                      @id @default(cuid())
  workspaceId                String
  type                       DataSourceType
  name                       String
  provider                   String
  isActive                   Boolean                     @default(true)
  status                     ConnectionStatus            @default(PENDING)
  connectionMode             String?
  authMethod                 String?
  contentHash                String?
  sourceFingerprint          String?
  supersedesDataSourceId     String?
  config                     Json?
  schemas                    Json?
  lastErrorMessage           String?
  connectedAt                DateTime?
  lastSyncAt                 DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  workspace                  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  schemaSnapshots            SchemaSnapshot[]
  stats                      DataSourceStats[]
  primaryReportRuns          ReportRun[]                 @relation("ReportRunPrimaryDataSource")
  ecommerceConnectorAccounts EcommerceConnectorAccount[]
  ecommerceSyncRuns          EcommerceSyncRun[]
  ecommerceSyncArtifacts     EcommerceSyncArtifact[]
  googleAdsConnections       GoogleAdsConnection[]
  advertisingAccounts        AdvertisingAccount[]
  advertisingCampaigns       AdvertisingCampaign[]
  advertisingAdSets          AdvertisingAdSet[]
  advertisingAds             AdvertisingAd[]
  advertisingCreatives       AdvertisingCreative[]
  advertisingCreativeAssets  AdvertisingCreativeAsset[]
  advertisingPerformanceDaily AdvertisingPerformanceDaily[]
  advertisingProductMappings AdvertisingProductMapping[]
  advertisingProfitSnapshots AdvertisingProfitSnapshot[]

  @@index([workspaceId, status])
  @@index([workspaceId, contentHash])
  @@index([workspaceId, sourceFingerprint])
}

model GoogleAdsConnection {
  id                         String                @id @default(cuid())
  workspaceId                String
  dataSourceId               String?
  customerId                 String
  loginCustomerId            String?
  encryptedRefreshToken      String
  accessTokenLastRefreshedAt DateTime?
  status                     String                @default("connected")
  lastSyncedAt               DateTime?
  syncCursor                 Json?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  workspace                  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource                 DataSourceConnection? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, customerId])
  @@index([workspaceId, dataSourceId])
  @@index([workspaceId, status])
}

model OAuthState {
  id           String    @id @default(cuid())
  stateHash    String    @unique
  provider     String
  workspaceId  String
  userId       String?
  shopDomain   String
  redirectUri  String
  scopes       String
  nonce        String
  expiresAt    DateTime
  usedAt       DateTime?
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, provider])
  @@index([provider, shopDomain])
  @@index([expiresAt])
}

model EcommerceConnectorAccount {
  id                   String                  @id @default(cuid())
  workspaceId          String
  dataSourceId         String?
  provider             String
  shopDomain           String
  encryptedAccessToken String
  scopes               String
  grantedScopes        String?
  requiredScopes       String?
  scopeStatus          String                  @default("OK")
  status               String                  @default("connected")
  lastSyncedAt         DateTime?
  autoSyncEnabled      Boolean                 @default(true)
  syncIntervalMinutes  Int                     @default(360)
  nextSyncAt           DateTime?
  lastAutoSyncAttemptAt DateTime?
  lastAutoSyncSuccessAt DateTime?
  autoSyncFailureCount Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource           DataSourceConnection?   @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  syncRuns             EcommerceSyncRun[]
  syncArtifacts        EcommerceSyncArtifact[]

  @@unique([workspaceId, provider, shopDomain])
  @@index([workspaceId, dataSourceId])
  @@index([workspaceId, provider])
}

model EcommerceSyncRun {
  id                 String                    @id @default(cuid())
  workspaceId        String
  dataSourceId       String
  connectorAccountId String
  provider           String
  shopDomain         String
  syncRunId          String                    @unique
  idempotencyKey     String
  status             String                    @default("running")
  syncWindowStart    DateTime?
  syncWindowEnd      DateTime?
  cursorJson         Json?
  rowsPulled         Int                       @default(0)
  rowsNormalized     Int                       @default(0)
  rowsRejected       Int                       @default(0)
  manifestKey        String?
  errorMessage       String?
  startedAt          DateTime                  @default(now())
  finishedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource         DataSourceConnection      @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  connectorAccount   EcommerceConnectorAccount @relation(fields: [connectorAccountId], references: [id], onDelete: Cascade)
  artifacts          EcommerceSyncArtifact[]

  @@unique([workspaceId, dataSourceId, provider, shopDomain, idempotencyKey])
  @@index([workspaceId, dataSourceId, provider])
  @@index([connectorAccountId, startedAt])
}

model EcommerceSyncArtifact {
  id                 String                    @id @default(cuid())
  workspaceId        String
  dataSourceId       String
  connectorAccountId String
  syncRunId          String
  provider           String
  shopDomain         String
  artifactType       String
  tableName          String?
  artifactKey        String
  checksum           String
  rowCount           Int                       @default(0)
  createdAt          DateTime                  @default(now())
  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource         DataSourceConnection      @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  connectorAccount   EcommerceConnectorAccount @relation(fields: [connectorAccountId], references: [id], onDelete: Cascade)
  syncRun            EcommerceSyncRun          @relation(fields: [syncRunId], references: [syncRunId], onDelete: Cascade)

  @@unique([syncRunId, artifactKey])
  @@index([workspaceId, dataSourceId, provider])
  @@index([syncRunId])
}

model AdvertisingAccount {
  id              String               @id @default(cuid())
  workspaceId     String
  dataSourceId    String
  provider        String
  sourceAccountId String
  adAccountId     String
  accountName     String?
  currency        String?
  timezone        String?
  status          String?
  metadataJson    Json?
  lastSyncedAt    DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource      DataSourceConnection @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceAccountId, adAccountId], map: "ad_acct_identity_key")
  @@index([workspaceId, dataSourceId, provider], map: "ad_acct_source_idx")
  @@index([workspaceId, provider, status], map: "ad_acct_status_idx")
}

model AdvertisingCampaign {
  id               String               @id @default(cuid())
  workspaceId      String
  dataSourceId     String
  provider         String
  sourceAccountId  String
  adAccountId      String
  sourceCampaignId String
  campaignName     String?
  objective        String?
  buyingType       String?
  status           String?
  effectiveStatus  String?
  startTime        DateTime?
  stopTime         DateTime?
  metadataJson     Json?
  lastSyncedAt     DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource       DataSourceConnection @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceAccountId, sourceCampaignId], map: "ad_campaign_identity_key")
  @@index([workspaceId, dataSourceId, provider], map: "ad_campaign_source_idx")
  @@index([workspaceId, provider, effectiveStatus], map: "ad_campaign_status_idx")
}

model AdvertisingAdSet {
  id                String               @id @default(cuid())
  workspaceId       String
  dataSourceId      String
  provider          String
  sourceAccountId   String
  sourceCampaignId  String
  sourceAdSetId     String
  adSetName         String?
  optimizationGoal  String?
  billingEvent      String?
  bidStrategy       String?
  dailyBudget       Float?
  lifetimeBudget    Float?
  targetingSummary  Json?
  promotedObject    Json?
  status            String?
  effectiveStatus   String?
  metadataJson      Json?
  lastSyncedAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource        DataSourceConnection @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceAccountId, sourceAdSetId], map: "ad_set_identity_key")
  @@index([workspaceId, provider, sourceCampaignId], map: "ad_set_campaign_idx")
  @@index([workspaceId, dataSourceId, provider], map: "ad_set_source_idx")
}

model AdvertisingAd {
  id                   String               @id @default(cuid())
  workspaceId          String
  dataSourceId         String
  provider             String
  sourceAccountId      String
  sourceCampaignId     String?
  sourceAdSetId        String?
  sourceAdId           String
  sourceCreativeId     String?
  adName               String?
  status               String?
  effectiveStatus      String?
  createdTime          DateTime?
  updatedTime          DateTime?
  previewUrl           String?
  finalUrl             String?
  trackingParameters   Json?
  urlTags              String?
  sourcePayloadHash    String?
  metadataJson         Json?
  lastSyncedAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource           DataSourceConnection @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceAccountId, sourceAdId], map: "ad_identity_key")
  @@index([workspaceId, provider, sourceCampaignId], map: "ad_campaign_idx")
  @@index([workspaceId, provider, sourceAdSetId], map: "ad_adset_idx")
  @@index([workspaceId, provider, sourceCreativeId], map: "ad_creative_idx")
}

model AdvertisingCreative {
  id                    String               @id @default(cuid())
  workspaceId           String
  dataSourceId          String
  provider              String
  sourceAccountId       String
  sourceCreativeId      String
  creativeName          String?
  creativeFormat        String?
  objectStorySpec       Json?
  assetFeedSpec         Json?
  imageHash             String?
  imageUrl              String?
  thumbnailUrl          String?
  videoId               String?
  videoThumbnailUrl     String?
  primaryText           String?
  headline              String?
  description           String?
  callToAction          String?
  destinationUrl        String?
  pageId                String?
  instagramActorId      String?
  catalogReference      Json?
  sourcePayloadHash     String?
  metadataJson          Json?
  lastSyncedAt          DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource            DataSourceConnection @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceAccountId, sourceCreativeId], map: "ad_creative_identity_key")
  @@index([workspaceId, dataSourceId, provider], map: "ad_creative_source_idx")
  @@index([workspaceId, provider, creativeFormat], map: "ad_creative_format_idx")
}

model AdvertisingCreativeAsset {
  id                String                      @id @default(cuid())
  workspaceId       String
  dataSourceId      String
  provider          String
  sourceAccountId   String
  sourceCreativeId  String?
  sourceAssetId     String
  assetType         CreativeAssetType
  role              String?
  textContent       String?
  imageUrl          String?
  thumbnailUrl      String?
  videoId           String?
  contentHash       String
  sourcePayloadHash String?
  metadataJson      Json?
  status            CreativeAssetStatus         @default(ACTIVE)
  firstSeenAt       DateTime                    @default(now())
  lastSeenAt        DateTime                    @default(now())
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  workspace         Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataSource        DataSourceConnection        @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  links             AdvertisingCreativeAssetLink[]

  @@unique([workspaceId, provider, sourceAccountId, sourceAssetId, contentHash], map: "ad_asset_identity_key")
  @@index([workspaceId, dataSourceId, provider], map: "ad_asset_source_idx")
  @@index([workspaceId, provider, assetType], map: "ad_asset_type_idx")
  @@index([workspaceId, provider, contentHash], map: "ad_asset_hash_idx")
}

model AdvertisingCreativeAssetLink {
  id                String                  @id @default(cuid())
  workspaceId       String
  provider          String
  sourceAccountId   String
  sourceAdId        String?
  sourceCreativeId  String
  creativeAssetId   String
  assetRole         String?
  position          Int?
  validFrom         DateTime                @default(now())
  validTo           DateTime?
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creativeAsset     AdvertisingCreativeAsset @relation(fields: [creativeAssetId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, sourceAccountId, sourceAdId, sourceCreativeId, creativeAssetId, assetRole, position], map: "ad_asset_link_identity_key")
  @@index([workspaceId, provider, sourceAdId], map: "ad_asset_link_ad_idx")
  @@index([workspaceId, provider, sourceCreativeId], map: "ad_asset_link_creative_idx")
  @@index([workspaceId, creativeAssetId], map: "ad_asset_link_asset_idx")
}

model AdvertisingPerformanceDaily {
  id                     String                   @id @default(cuid())
  workspaceId            String
  dataSourceId           String
  provider               String
  sourceAccountId        String
  sourceCampaignId       String?
  sourceAdSetId          String?
  sourceAdId             String?
  sourceCreativeId       String?
  creativeAssetId        String?
  date                   DateTime
  attributionLevel       CreativeAttributionLevel
  attributionConfidence  Float                    @default(1)
  attributionMethod      String
  sourceMetricScope      String
  impressions            Int?
  reach                  Int?
